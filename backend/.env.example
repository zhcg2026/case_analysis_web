# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT配置（必填，缺失则启动报错）
JWT_SECRET_KEY=your-strong-secret-key-at-least-32-chars
TOKEN_EXPIRATION_SECONDS=86400

# 火山引擎API Key
ARK_API_KEY=your-ark-api-key

# 阿里云百炼API Key
BAILIAN_GENERAL_API_KEY=your-bailian-general-key
BAILIAN_CHENGGUANTONG_API_KEY=your-bailian-chengguantong-key

# CORS配置（生产环境设置为具体域名，如 https://example.com）
CORS_ORIGINS=*

# 天气API Key
WEATHER_API_KEY=your-weather-api-key
